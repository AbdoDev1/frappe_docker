ARG FRAPPE_BUILD_IMAGE
ARG FRAPPE_BASE_IMAGE
ARG FRAPPE_REF
ARG FRAPPE_SHA
ARG ERPNEXT_REF
ARG ERPNEXT_SHA
ARG CACHE_BUST

FROM ${FRAPPE_BUILD_IMAGE} AS builder

ARG FRAPPE_REF
ARG FRAPPE_SHA
ARG ERPNEXT_REF
ARG ERPNEXT_SHA
ARG CACHE_BUST
ARG FRAPPE_PATH=https://github.com/frappe/frappe

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
    --mount=type=secret,id=pins,target=/tmp/pins.list,required=true,uid=1000,gid=1000 \
  : "${FRAPPE_REF:?missing FRAPPE_REF}" && \
  : "${FRAPPE_SHA:?missing FRAPPE_SHA}" && \
  : "${ERPNEXT_REF:?missing ERPNEXT_REF}" && \
  : "${ERPNEXT_SHA:?missing ERPNEXT_SHA}" && \
  : "${CACHE_BUST:?missing CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_REF} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  test "$(git -C apps/frappe rev-parse HEAD)" = "${FRAPPE_SHA}" || \
    { echo "FRAPPE_SHA mismatch: expected ${FRAPPE_SHA} got $(git -C apps/frappe rev-parse HEAD)"; exit 1; } && \
  test "$(git -C apps/erpnext rev-parse HEAD)" = "${ERPNEXT_SHA}" || \
    { echo "ERPNEXT_SHA mismatch: expected ${ERPNEXT_SHA} got $(git -C apps/erpnext rev-parse HEAD)"; exit 1; } && \
  pinned_count=0; while read -r name url sha kind ref; do \
    [ -n "$name" ] || continue; \
    remote="$(git -C "apps/$name" remote)" || exit 1; \
    test "$(printf '%s' "$remote" | wc -w)" = "1" || { echo "expected exactly one remote for $name"; exit 1; }; \
    u1="$(git -C "apps/$name" config "remote.$remote.url")" || exit 1; \
    u1=${u1%/}; u1=${u1%.git}; u2=${url%/}; u2=${u2%.git}; \
    test "$u1" = "$u2" || { echo "remote url mismatch for $name"; exit 1; }; \
    if [ "$kind" = "tag" ]; then git -C "apps/$name" fetch --no-tags "$remote" "refs/tags/$ref:refs/tags/$ref" || exit 1; \
    fetched_sha="$(git -C "apps/$name" rev-parse "refs/tags/$ref^{commit}")" || exit 1; \
    else git -C "apps/$name" fetch --no-tags "$remote" "refs/heads/$ref:refs/remotes/$remote/$ref" || exit 1; \
    fetched_sha="$(git -C "apps/$name" rev-parse "refs/remotes/$remote/$ref^{commit}")" || exit 1; fi; \
    test "$fetched_sha" = "$sha" || { echo "$name ref/SHA mismatch: ref $ref resolves to $fetched_sha, wanted $sha"; exit 1; }; \
    if git -C "apps/$name" rev-parse --is-shallow-repository | grep -q true; then git -C "apps/$name" fetch --unshallow "$remote" || exit 1; fi; \
    git -C "apps/$name" cat-file -e "${sha}^{commit}" || exit 1; \
    git -C "apps/$name" checkout --detach "$sha" || exit 1; \
    test "$(git -C "apps/$name" rev-parse HEAD)" = "$sha" || { echo "$name SHA mismatch"; exit 1; }; \
    pinned_count=$((pinned_count+1)); \
  done < /tmp/pins.list && \
  echo "pinned_count=$pinned_count" && \
  test "$pinned_count" = "6" || { echo "pinned $pinned_count apps, expected 6"; exit 1; } && \
  found=0; : > /home/frappe/frappe-bench/BUILD-SHAs && \
  for d in apps/*/; do \
    if [ -d "$d/.git" ]; then \
      echo "$(basename $d)=$(git -C $d rev-parse HEAD)" >> /home/frappe/frappe-bench/BUILD-SHAs; \
      found=1; \
    fi; \
  done && \
  test "$found" = "1" || { echo "no .git directories under apps/ — refusing build"; exit 1; } && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_BASE_IMAGE} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

ARG CACHE_BUST
ARG FRAPPE_SHA
ARG ERPNEXT_SHA
LABEL biozone.frappe-sha="${FRAPPE_SHA}" biozone.erpnext-sha="${ERPNEXT_SHA}" biozone.cache-bust="${CACHE_BUST}"

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
