ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe
ARG FRAPPE_BUILD_IMAGE_DIGEST=""
ARG FRAPPE_BASE_IMAGE_DIGEST=""

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH}${FRAPPE_BUILD_IMAGE_DIGEST} AS builder

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG FRAPPE_REF=v16.36.0
ARG FRAPPE_SHA=f3f0c0b13c77a419487150a198fed42964e1919e
ARG ERPNEXT_SHA=fb78e58b8c037bcff4f90b7361ad81ff7b1c42ba
ARG CACHE_BUST=""

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_REF} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  test "$(git -C apps/frappe rev-parse HEAD)" = "${FRAPPE_SHA}" || \
    { echo "FRAPPE_SHA mismatch: expected ${FRAPPE_SHA} got $(git -C apps/frappe rev-parse HEAD)"; exit 1; } && \
  test "$(git -C apps/erpnext rev-parse HEAD)" = "${ERPNEXT_SHA}" || \
    { echo "ERPNEXT_SHA mismatch: expected ${ERPNEXT_SHA} got $(git -C apps/erpnext rev-parse HEAD)"; exit 1; } && \
  found=0; : > /home/frappe/frappe-bench/BUILD-SHAs && \
  for d in apps/*/; do \
    if [ -d "$d/.git" ]; then \
      echo "$(basename $d)=$(git -C $d rev-parse HEAD)" >> /home/frappe/frappe-bench/BUILD-SHAs; \
      found=1; \
    fi; \
  done && \
  test "$found" = "1" || { echo "no .git directories under apps/ — refusing build"; exit 1; } && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH}${FRAPPE_BASE_IMAGE_DIGEST} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

ARG CACHE_BUST=""
ARG FRAPPE_SHA=f3f0c0b13c77a419487150a198fed42964e1919e
ARG ERPNEXT_SHA=fb78e58b8c037bcff4f90b7361ad81ff7b1c42ba
LABEL biozone.frappe-sha="${FRAPPE_SHA}" biozone.erpnext-sha="${ERPNEXT_SHA}" biozone.cache-bust="${CACHE_BUST}"

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
